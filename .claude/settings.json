{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SKIP_HEAVY=1 bash \"$CLAUDE_PROJECT_DIR/install-all.sh\" >/tmp/claude-tools-install.log 2>&1",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "env": {
    "HYPERFRAMES_STANDALONE_CLI_VERSION": "0.9.93",
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1"
  }
}
