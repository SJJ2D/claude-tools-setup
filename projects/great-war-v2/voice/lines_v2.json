 {
  "id": "c_leader",
  "who": "leader",
  "emo": "sarcastic",
  "ex": 0.55,
  "text": "أنا ما أصيد السمك... السمك يسلّم نفسه."
 },
 {
  "id": "n5",
  "who": "narr",
  "emo": "sarcastic",
  "ex": 0.55,
